# Vercel environment variables example
# Copy values into the Vercel UI (Project → Settings → Environment Variables)
# Do NOT commit real tokens to source control.

PROXY_API_TOKEN=eduquery-dev-REPLACE_WITH_RANDOM
HF_API_TOKEN=hf_REPLACE_WITH_YOUR_TOKEN
HF_MODEL=gpt2
LLM_PROVIDER=hf
LLM_RATE_WINDOW_MS=60000
LLM_RATE_MAX=20

# Notes:
# - PROXY_API_TOKEN: strong random token used to authorize clients to the /api/llm-proxy endpoint.
# - HF_API_TOKEN: your Hugging Face token (only needed if LLM_PROVIDER=hf).
# - HF_MODEL: pick a public model available to your HF account (gpt2 is an example, small and free).
# - LLM_RATE_*: keep conservative values for free-tier testing.
